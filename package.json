{
  "name": "welding-tracker",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "dev:local": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "maintenance:dispatcher": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/maintenance/dispatcher-refresh',{method:'POST',headers:{authorization:'Bearer '+process.env.MAINTENANCE_TOKEN}}).then(async r=>{console.log(await r.text());if(!r.ok)process.exit(1)})\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:remote-migration": "drizzle-kit migrate --config=drizzle.remote.config.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit:prod": "pnpm audit --prod",
    "audit:all": "pnpm audit",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm audit:prod && pnpm audit:all"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-start": "^1.168.42",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.468.0",
    "nitro": "3.0.260610-beta",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tanstack/router-plugin": "^1.168.29",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "drizzle-kit": "^0.31.10",
    "image-size": "file:vendor/image-size-2.0.3-security.0.tgz",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
