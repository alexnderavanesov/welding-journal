DATABASE_URL=postgres://welding:welding@localhost:5432/welding_tracker
DATABASE_SSL_CA=
DATABASE_URL_REMOTE_FOR_MIGRATIONS=postgres://user:password@remote-host:5432/welding_tracker
VITE_AG_GRID_LICENSE_KEY=

# Generate a private random value of at least 32 characters; never commit it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Keep false unless the verified reverse proxy overwrites incoming client-IP headers.
AUTH_TRUST_PROXY=false

# Local mode saves private .eml files and never sends real email.
AUTH_MAIL_MODE=local
AUTH_MAIL_FROM=system@yums.ru
AUTH_MAIL_LOCAL_DIR=data/auth-mail
SMTP_HOST=127.0.0.1
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Postbox over HTTPS (443): set AUTH_MAIL_MODE=postbox on the server.
# Static access key of a service account with postbox.sender in the verified domain's folder.
# Runtime secrets only. Never use VITE_ variables or commit real values.
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
# PDF bytes for «Схемы линий» are separate from PostgreSQL metadata.
# Default is local; adding S3 credentials alone does not switch storage.
LINE_SCHEME_STORAGE_DRIVER=local
# Local mode: development defaults to data/line-schemes; production requires a persistent directory.
# Local production-mode tests must point to their own disposable directory.
# LINE_SCHEME_STORAGE_PATH=/absolute/path/to/line-schemes
# Opt-in S3 mode: LINE_SCHEME_STORAGE_DRIVER=s3, private vHosted bucket.
# Server runtime only; no VITE_ prefix and no credentials in Git or client code.
# LINE_SCHEME_S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru
# LINE_SCHEME_S3_REGION=ru-1
# LINE_SCHEME_S3_BUCKET=welding-journal-schemes-test
# LINE_SCHEME_S3_ACCESS_KEY_ID=
# LINE_SCHEME_S3_SECRET_ACCESS_KEY=
