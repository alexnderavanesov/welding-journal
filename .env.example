DATABASE_URL=postgres://welding:welding@localhost:5432/welding_tracker
DATABASE_SSL_CA=
DATABASE_URL_REMOTE_FOR_MIGRATIONS=postgres://user:password@remote-host:5432/welding_tracker
VITE_AG_GRID_LICENSE_KEY=

# Generate a private random value of at least 32 characters; never commit it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Keep false unless the verified reverse proxy overwrites incoming client-IP headers.
AUTH_TRUST_PROXY=false

# Local mode saves private .eml files and never sends real email.
AUTH_MAIL_MODE=local
AUTH_MAIL_FROM=system@yums.ru
AUTH_MAIL_LOCAL_DIR=data/auth-mail
SMTP_HOST=127.0.0.1
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Postbox over HTTPS (443): set AUTH_MAIL_MODE=postbox on the server.
# Static access key of a service account with postbox.sender in the verified domain's folder.
# Runtime secrets only. Never use VITE_ variables or commit real values.
POSTBOX_ACCESS_KEY_ID=
POSTBOX_SECRET_ACCESS_KEY=
